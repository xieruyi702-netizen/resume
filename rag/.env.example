# 智谱开放平台 https://open.bigmodel.cn
ZHIPU_API_KEY=your_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 简历口径：生成 DeepSeek V4 Flash / Judge GLM-5.3-Flash（跨源降同源偏好）
MEISHI_GEN_MODEL=deepseek-v4-flash
MEISHI_JUDGE_MODEL=glm-5.3-flash

# 向量检索：本地 BGE（默认）或智谱 embedding-3
MEISHI_EMBED_BACKEND=local
MEISHI_LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5
MEISHI_EMBED_MODEL=embedding-3
MEISHI_EMBED_DIM=512
MEISHI_RETRIEVAL=hybrid

# Tavily 网页检索（可选；不填则走 keyless 试用，有限额）
# https://tavily.com → TAVILY_API_KEY=tvly-...
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# 分层记忆：短期 Redis（docker redis-memory:6382）+ 长期 Chroma 向量库
MEISHI_REDIS_MEMORY=127.0.0.1:6382
MEISHI_SESSION_TTL_SEC=86400
MEISHI_SESSION_MAX_TURNS=12
MEISHI_CHROMA_PATH=rag/memory_store/chroma_ltm
MEISHI_LTM_MAX_PER_USER=200
# 注入 Agent 的记忆字符预算（长期优先，总封顶）
MEISHI_CTX_LTM_CHARS=800
MEISHI_CTX_STM_CHARS=1200
MEISHI_CTX_TOTAL_CHARS=2000
