# LLM 接入（OpenAI 兼容协议，三行切换任意厂商）
# DeepSeek V4（2026-07 起 deepseek-chat 已退役，用新模型名）：
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=你的key
# 智谱 GLM：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4-flash

# Judge（LLM-as-Judge，跨源判分：被测 DeepSeek / 判分 GLM；GLM-4-Flash 免费额度可用）
# JUDGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# JUDGE_MODEL=glm-4-flash
# JUDGE_API_KEY=你的智谱key

# 无 key 时置 1 可用 MockLLM 验证全链路 plumbing（不发真实请求）
# DRY_RUN=1

# 检索增强开关（重排模型 ~1.1GB，首次启用会自动下载）
# USE_RERANK=1
# EMBED_MODEL=BAAI/bge-small-zh-v1.5
# RERANK_MODEL=BAAI/bge-reranker-base
